{
  "name": "a11y-atomic",
  "version": "0.1.0",
  "description": "Atomic CSS framework driven by an accessibility widget: every utility reads CSS variables that the widget's modes change.",
  "keywords": [
    "css",
    "atomic-css",
    "utility-css",
    "css-variables",
    "accessibility",
    "a11y",
    "wcag",
    "widget",
    "grid"
  ],
  "author": "Andrew Rico",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/a11y-atomic.css",
    "./min": "./dist/a11y-atomic.min.css",
    "./core": "./dist/a11y-core.css",
    "./init": "./dist/a11y-init.js",
    "./widget": "./src/widget.js",
    "./atomic": "./src/atomic.js",
    "./vars": "./src/vars.js",
    "./grid": "./src/grid.styles.js",
    "./shadow": "./src/shadow.js",
    "./auto": "./src/auto.js",
    "./tokens": "./src/tokens.mjs",
    "./build": "./scripts/build.mjs",
    "./eleventy": "./src/eleventy.js"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/build.mjs",
    "LICENSE",
    "README.md",
    "WCAG.md",
    "wcag/"
  ],
  "bin": {
    "a11y-atomic": "scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build.mjs --content",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node scripts/build.mjs && node --test",
    "test:browser": "node scripts/build.mjs && node scripts/demo-compile.mjs && node scripts/browser-check.mjs",
    "demo:compile": "node scripts/demo-compile.mjs",
    "check": "npm test && npm run test:browser",
    "wcag:sync": "node scripts/wcag-sync.mjs",
    "wcag:report": "node scripts/wcag-report.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1"
  }
}
